[Unit]
Description=LVS STT worker (faster-whisper)
Requires=lvs-stt.socket
After=lvs-stt.socket

[Service]
Type=simple
WorkingDirectory=%h/.local/share/lvs-stt
ExecStart=%h/.local/share/lvs-stt/venv/bin/python3 %h/.local/share/lvs-stt/transcribe_whisper_fast.py --serve --socket %t/lvs-stt.sock
Restart=always
RestartSec=2
EnvironmentFile=-%h/.config/lvs/lvs-stt.env

[Install]
WantedBy=default.target
